---
import { translations } from '../data/translations';

type Lang = keyof typeof translations;

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = translations[lang];
---

<section id="about" class="mx-auto max-w-6xl px-6 py-24">
  <div class="mb-12">
    <p class="text-sm text-primary-light">
      $ cat about.txt
    </p>

    <h2 class="mt-3 text-3xl font-bold text-text md:text-4xl">
      {t.about.title}
    </h2>
  </div>

  <div class="grid gap-12 md:grid-cols-2">
    <div>
      <p class="text-lg leading-8 text-text">
        {t.about.intro}
      </p>

      <p class="mt-6 leading-7 text-text-muted">
        {t.about.experience}
      </p>

      <p class="mt-6 leading-7 text-text-muted">
        {t.about.collaboration}
      </p>
    </div>

    <div class="border-l border-surface pl-6">
      <div>
        <p class="text-sm text-primary-light">
          role
        </p>

        <p class="mt-2 text-text">
          {t.about.role}
        </p>
      </div>

      <div class="mt-8">
        <p class="text-sm text-primary-light">
          focus
        </p>

        <p class="mt-2 text-text">
          {t.about.focus}
        </p>
      </div>

      <div class="mt-8">
        <p class="text-sm text-primary-light">
          approach
        </p>

        <p class="mt-2 text-text">
          {t.about.approach}
        </p>
      </div>
    </div>
  </div>
</section>