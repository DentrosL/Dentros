---
import { translations } from '../data/translations';

type Lang = keyof typeof translations;

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = translations[lang];
---

<section
  id="about"
  class="relative w-full scroll-mt-20 overflow-hidden px-5 py-20 sm:px-8 sm:py-24 md:px-12 lg:py-28 xl:px-16"
>
  <div
    class="pointer-events-none absolute -left-40 top-1/3 h-80 w-80 rounded-full bg-primary/10 blur-[120px]"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full">
    <header class="mb-12 sm:mb-16">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <p class="text-sm text-primary-light">$ cat about.txt</p>

        <span class="rounded-md border border-border bg-surface/60 px-2.5 py-1 text-[10px] tracking-wider text-text-muted">
          ABOUT_ME
        </span>
      </div>

      <h2 class="text-4xl font-bold tracking-tight text-text sm:text-5xl lg:text-6xl">
        {t.about.title}
        <span class="text-primary-light">.</span>
      </h2>
    </header>

    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16 xl:gap-24">
      <div class="min-w-0">
        <div class="mb-8 flex items-start gap-4">
          <span
            class="mt-1 h-12 w-1 shrink-0 rounded-full bg-linear-to-b from-primary-light to-primary-dark"
            aria-hidden="true"
          ></span>

          <p class="max-w-3xl text-xl font-medium leading-relaxed text-text sm:text-2xl sm:leading-relaxed">
            {t.about.intro}
          </p>
        </div>

        <div class="max-w-3xl space-y-6 pl-5">
          <p class="text-sm leading-8 text-text-muted sm:text-base">
            {t.about.experience}
          </p>

          <p class="text-sm leading-8 text-text-muted sm:text-base">
            {t.about.collaboration}
          </p>
        </div>

        <div class="mt-10 flex items-center gap-3 pl-5">
          <span
            class="h-2 w-2 rounded-full bg-success shadow-[0_0_12px_rgba(74,222,128,0.35)]"
            aria-hidden="true"
          ></span>

          <span class="text-xs tracking-wide text-text-muted">
            {t.about.approach}
          </span>
        </div>
      </div>

      <aside
        class="h-fit overflow-hidden rounded-2xl border border-border bg-surface/60 shadow-xl shadow-black/10"
        aria-label={t.about.title}
      >
        <div class="flex items-center justify-between border-b border-border bg-background/40 px-5 py-4 sm:px-6">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-danger/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-primary-light/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-success/80"></span>
          </div>

          <span class="font-mono text-[10px] tracking-wider text-text-muted">
            PROFILE.config
          </span>
        </div>

        <div class="divide-y divide-border/70">
          <div class="p-5 transition-colors hover:bg-primary/5 sm:p-6">
            <div class="flex items-start gap-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/25 bg-primary/10 font-mono text-sm text-primary-light"
                aria-hidden="true"
              >
                01
              </span>

              <div class="min-w-0 flex-1">
                <p class="text-xs tracking-wide text-primary-light">role</p>

                <p class="mt-2 font-medium leading-6 text-text">
                  {t.about.role}
                </p>
              </div>
            </div>
          </div>

          <div class="p-5 transition-colors hover:bg-primary/5 sm:p-6">
            <div class="flex items-start gap-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/25 bg-primary/10 font-mono text-sm text-primary-light"
                aria-hidden="true"
              >
                02
              </span>

              <div class="min-w-0 flex-1">
                <p class="text-xs tracking-wide text-primary-light">focus</p>

                <p class="mt-2 font-medium leading-6 text-text">
                  {t.about.focus}
                </p>
              </div>
            </div>
          </div>

          <div class="p-5 transition-colors hover:bg-primary/5 sm:p-6">
            <div class="flex items-start gap-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/25 bg-primary/10 font-mono text-sm text-primary-light"
                aria-hidden="true"
              >
                03
              </span>

              <div class="min-w-0 flex-1">
                <p class="text-xs tracking-wide text-primary-light">approach</p>

                <p class="mt-2 font-medium leading-6 text-text">
                  {t.about.approach}
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between gap-4 border-t border-border bg-background/40 px-5 py-4 sm:px-6">
          <span class="flex items-center gap-2 text-xs text-success">
            <span aria-hidden="true">●</span>
            <span>PROFILE_LOADED</span>
          </span>

          <span class="font-mono text-[10px] text-text-muted">JSON / 03</span>
        </div>
      </aside>
    </div>
  </div>
</section>
