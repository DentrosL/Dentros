---
import { contacts } from '../data/contacts';
import { translations } from '../data/translations';

type Lang = keyof typeof translations;

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = translations[lang];
---

<section
  id="contact"
  class="relative w-full overflow-hidden px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28 xl:px-16 2xl:px-20"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 top-0 h-96 w-96 rounded-full bg-primary/10 blur-[140px]"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 left-0 h-72 w-72 rounded-full bg-success/5 blur-[120px]"
  ></div>

  <div class="relative mb-8 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="h-2 w-2 animate-pulse rounded-full bg-success"></span>

      <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary-light">
        {t.contact.eyebrow}
      </p>
    </div>

    <span class="font-mono text-[10px] tracking-widest text-text-muted sm:text-xs">
      $ ./contact.sh
    </span>
  </div>

  <div class="relative grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12 xl:gap-20">
    <div class="relative flex flex-col justify-between overflow-hidden rounded-2xl border border-border bg-surface/50 p-6 sm:p-9 lg:p-10 xl:p-12">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-primary/10 blur-[90px]"
      ></div>

      <div class="relative">
        <p class="mb-5 font-mono text-xs uppercase tracking-widest text-success">
          {t.contact.availability}
        </p>

        <h2 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-text sm:text-5xl lg:text-6xl xl:text-7xl">
          {t.contact.title}
          <span class="text-primary-light">.</span>
        </h2>

        <p class="mt-6 max-w-xl text-sm leading-7 text-text-muted sm:text-base sm:leading-8">
          {t.contact.description}
        </p>

        <div class="mt-8 flex items-center gap-3">
          <span class="h-px w-10 bg-primary-light"></span>

          <span class="font-mono text-xs text-text-muted">
            {t.contact.availabilityDescription}
          </span>
        </div>
      </div>

      <div class="relative mt-12 overflow-hidden rounded-xl border border-border bg-background/80">
        <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3 sm:px-5">
          <div class="flex items-center gap-2" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-danger"></span>
            <span class="h-2 w-2 rounded-full bg-primary-light"></span>
            <span class="h-2 w-2 rounded-full bg-success"></span>
          </div>

          <span class="font-mono text-[10px] uppercase tracking-widest text-text-muted">
            contact.config
          </span>
        </div>

        <div class="grid gap-5 p-4 sm:grid-cols-2 sm:p-5">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted">
              {t.contact.responseLabel}
            </p>

            <p class="mt-2 font-mono text-sm text-primary-light">
              {t.contact.responseValue}
            </p>
          </div>

          <div>
            <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted">
              STATUS
            </p>

            <p class="mt-2 flex items-center gap-2 font-mono text-sm text-success">
              <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
              {t.contact.availability}
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="relative flex flex-col">
      <div class="mb-5">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-text-muted">
          / 01 - {t.contact.linksTitle}
        </p>

        <p class="mt-3 text-sm leading-7 text-text-muted">
          {t.contact.linksDescription}
        </p>
      </div>

      <div class="grid flex-1 gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:gap-4">
        {contacts.map((contact) => {
          const item = t.contact;
          const isEmail = contact.key === 'email';
          const isWhatsApp = contact.key === 'whatsapp';

          return (
            <a
              href={isWhatsApp ? undefined : contact.href}
              target={contact.external && !isWhatsApp ? '_blank' : undefined}
              rel={
                contact.external && !isWhatsApp
                  ? 'noopener noreferrer'
                  : undefined
              }
              aria-label={`${item.labels[contact.key]} - ${item.descriptions[contact.key]}`}
              aria-disabled={isWhatsApp ? 'true' : undefined}
              class:list={[
                'group relative flex min-h-28 items-center gap-4 overflow-hidden rounded-xl border p-4 transition-all duration-300 sm:p-5',
                !isWhatsApp &&
                  'border-border bg-surface/50 hover:-translate-y-0.5 hover:border-primary-light/50 hover:bg-surface',
                isWhatsApp && 'cursor-not-allowed border-danger/30 bg-danger/5',
                isEmail && 'sm:col-span-2 lg:col-span-1',
              ]}
            >
              <span
                aria-hidden="true"
                class:list={[
                  'absolute inset-y-0 left-0 w-0.5 origin-bottom scale-y-0 transition-transform duration-300 group-hover:scale-y-100',
                  isWhatsApp ? 'bg-danger' : 'bg-primary-light',
                ]}
              ></span>

              <span
                class:list={[
                  'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border bg-background transition-colors duration-300',
                  isWhatsApp
                    ? 'border-danger/30 text-danger'
                    : 'border-border text-primary-light group-hover:border-primary-light/30 group-hover:bg-primary/10',
                ]}
              >
                {contact.icon === 'mail' && (
                  <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                )}

                {contact.icon === 'linkedin' && (
                  <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
                    <rect x="2" y="9" width="4" height="12" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}

                {contact.icon === 'github' && (
                  <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                )}

                {contact.icon === 'whatsapp' && (
                  <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
                    <path d="M9 9a5 5 0 0 0 6 6" />
                  </svg>
                )}
              </span>

              <span class="min-w-0 flex-1">
                <span
                  class:list={[
                    'block font-bold transition-colors',
                    isWhatsApp
                      ? 'text-danger'
                      : 'text-text group-hover:text-primary-light',
                  ]}
                >
                  {item.labels[contact.key]}
                </span>

                <span class="mt-1 block text-xs leading-5 text-text-muted">
                  {item.descriptions[contact.key]}
                </span>
              </span>

              <span
                aria-hidden="true"
                class:list={[
                  'shrink-0 font-mono text-xs uppercase tracking-wider',
                  isWhatsApp
                    ? 'rounded border border-danger/30 bg-danger/10 px-2 py-1 text-danger'
                    : 'text-text-muted transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary-light',
                ]}
              >
                {isWhatsApp
                  ? lang === 'pt'
                    ? 'Indisponível'
                    : 'Unavailable'
                  : '↗'}
              </span>
            </a>
          );
        })}
      </div>

      <div class="mt-5 flex items-center gap-3 border-t border-border pt-5">
        <span class="font-mono text-primary-light">//</span>

        <p class="text-xs leading-6 text-text-muted">{t.contact.footerNote}</p>
      </div>
    </div>
  </div>
</section>
