---
import { translations } from '../data/translations';

type Lang = keyof typeof translations;

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = translations[lang];
---

<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="mb-12">
    <p class="text-sm text-primary-light">
      $ git status
    </p>

    <h2 class="mt-3 text-3xl font-bold text-text md:text-4xl">
      {t.currently.title}
    </h2>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <div class="border-l border-success pl-5">
      <p class="text-sm text-success">
        {t.currently.learning.label}
      </p>

      <h3 class="mt-3 font-bold text-text">
        {t.currently.learning.title}
      </h3>

      <p class="mt-3 leading-7 text-text-muted">
        {t.currently.learning.description}
      </p>
    </div>

    <div class="border-l border-success pl-5">
      <p class="text-sm text-success">
        {t.currently.building.label}
      </p>

      <h3 class="mt-3 font-bold text-text">
        {t.currently.building.title}
      </h3>

      <p class="mt-3 leading-7 text-text-muted">
        {t.currently.building.description}
      </p>
    </div>

    <div class="border-l border-success pl-5">
      <p class="text-sm text-success">
        {t.currently.exploring.label}
      </p>

      <h3 class="mt-3 font-bold text-text">
        {t.currently.exploring.title}
      </h3>

      <p class="mt-3 leading-7 text-text-muted">
        {t.currently.exploring.description}
      </p>
    </div>
  </div>
</section>