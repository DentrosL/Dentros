---
import { activities } from '../data/activities';
import { translations } from '../data/translations';

type Lang = keyof typeof translations;

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = translations[lang];
---

<section
  id="currently"
  class="relative w-full overflow-hidden px-5 py-20 sm:px-8 lg:px-12 xl:px-16 2xl:px-20"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 top-0 h-80 w-80 rounded-full bg-primary/10 blur-[120px]"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-20 -left-32 h-72 w-72 rounded-full bg-success/5 blur-[100px]"
  ></div>

  <header class="relative mb-10 grid gap-8 lg:mb-12 lg:grid-cols-[1.4fr_0.8fr] lg:items-center">
    <div>
      <div class="mb-5 flex flex-wrap items-center gap-3 font-mono text-xs">
        <span class="text-primary-light">$ git status</span>

        <span class="rounded-md border border-border px-2.5 py-1 text-text-muted">
          {t.currently.title.toUpperCase()}
        </span>
      </div>

      <h2 class="text-4xl font-bold tracking-tight text-text sm:text-5xl lg:text-6xl">
        {t.currently.introTitle}
        <span class="text-primary-light">.</span>
      </h2>

      <p class="mt-5 max-w-2xl text-sm leading-7 text-text-muted sm:text-base sm:leading-8">
        {t.currently.introDescription}
      </p>
    </div>

    <div class="relative lg:ml-auto lg:w-full lg:max-w-lg">
      <div class="overflow-hidden rounded-xl border border-border bg-surface/80 shadow-2xl shadow-black/10">
        <div class="flex items-center justify-between border-b border-border px-5 py-4">
          <div class="flex items-center gap-2" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-danger"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-primary-light"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-success"></span>
          </div>

          <span class="font-mono text-[10px] uppercase tracking-widest text-text-muted sm:text-xs">
            {t.currently.terminalTitle}
          </span>
        </div>

        <div class="space-y-3 px-5 py-6 font-mono text-xs sm:px-6 sm:py-7 sm:text-sm">
          <p class="wrap-break-word">
            <span class="text-primary-light">const</span>
            <span class="text-text"> status = </span>
            <span class="text-success">'{t.currently.terminalStatus}'</span>;
          </p>

          <p class="wrap-break-word">
            <span class="text-primary-light">const</span>
            <span class="text-text"> mindset = </span>
            <span class="text-success">'{t.currently.terminalMindset}'</span>;
          </p>
        </div>
      </div>

      <div
        aria-hidden="true"
        class="absolute -bottom-1 left-8 right-8 h-px bg-linear-to-r from-transparent via-primary-light/50 to-transparent"
      ></div>
    </div>
  </header>

  <div class="relative mb-5 flex flex-wrap items-center justify-between gap-3 border-y border-border py-4">
    <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-text-muted sm:text-xs">
      {t.currently.overview}
    </p>

    <p class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-text-muted sm:text-xs">
      <span class="h-2 w-2 animate-pulse rounded-full bg-success"></span>
      {t.currently.inProgress}
    </p>
  </div>

  <div class="relative grid grid-cols-1 gap-5 md:grid-cols-3 xl:gap-7">
    {activities.map((activity) => {
      const item = t.currently[activity.key];

      const accentText =
        activity.accent === 'green'
          ? 'text-success'
          : 'text-primary-light';

      const accentBorder =
        activity.accent === 'green'
          ? 'border-success/70'
          : 'border-primary-light/70';

      const accentBackground =
        activity.accent === 'green'
          ? 'bg-success/10'
          : 'bg-primary/10';

      const accentGlow =
        activity.accent === 'green'
          ? 'bg-success/10'
          : 'bg-primary/10';

      return (
        <article
          class:list={[
            'group relative flex min-h-90 flex-col overflow-hidden rounded-2xl border border-border bg-surface/60 p-5 transition-all duration-300 sm:min-h-95 sm:p-7',
            'hover:-translate-y-1 hover:bg-surface',
            `hover:${accentBorder}`,
          ]}
        >
          <div
            aria-hidden="true"
            class:list={[
              'absolute inset-x-0 top-0 h-px opacity-80 transition-opacity group-hover:opacity-100',
              activity.accent === 'green'
                ? 'bg-linear-to-r from-transparent via-success to-transparent'
                : 'bg-linear-to-r from-transparent via-primary-light to-transparent',
            ]}
          ></div>

          <div
            aria-hidden="true"
            class:list={[
              'pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full opacity-50 blur-3xl transition-opacity duration-300 group-hover:opacity-100',
              accentGlow,
            ]}
          ></div>

          <div class="relative flex items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <span class:list={['font-mono text-sm font-bold', accentText]}>
                {activity.id}
              </span>

              <span
                aria-hidden="true"
                class:list={[
                  'h-px w-10 sm:w-14',
                  activity.accent === 'green'
                    ? 'bg-success/50'
                    : 'bg-primary-light/50',
                ]}
              ></span>
            </div>

            <span
              class:list={[
                'inline-flex items-center gap-2 rounded-full border border-border px-3 py-1.5 font-mono text-[9px] uppercase tracking-wider sm:text-[10px]',
                accentText,
              ]}
            >
              <span class:list={['h-1.5 w-1.5 rounded-full', activity.accent === 'green' ? 'bg-success' : 'bg-primary-light']}></span>
              {item.label}
            </span>
          </div>

          <div class="relative mt-8">
            <div
              class:list={[
                'flex h-14 w-14 items-center justify-center rounded-xl border border-border',
                accentBackground,
                accentText,
              ]}
            >
              {activity.icon === 'book' && (
                <svg
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="27"
                  height="27"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 7v14" />
                  <path d="M3 18V5a2 2 0 0 1 2-2h4a3 3 0 0 1 3 3 3 3 0 0 1 3-3h4a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-4a3 3 0 0 0-3 2 3 3 0 0 0-3-2H5a2 2 0 0 1-2-2Z" />
                </svg>
              )}

              {activity.icon === 'code' && (
                <svg
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="27"
                  height="27"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m8 17-5-5 5-5" />
                  <path d="m16 7 5 5-5 5" />
                  <path d="m14 4-4 16" />
                </svg>
              )}

              {activity.icon === 'compass' && (
                <svg
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="27"
                  height="27"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="m16.2 7.8-2.1 6.3-6.3 2.1 2.1-6.3 6.3-2.1Z" />
                </svg>
              )}
            </div>
          </div>

          <div class="relative mt-5 flex flex-1 flex-col">
            <h3 class="text-xl font-bold leading-snug tracking-tight text-text sm:text-2xl">
              {item.title}
            </h3>

            <p class="mt-3 text-sm leading-7 text-text-muted">
              {item.description}
            </p>
          </div>

          <div class="relative mt-7 flex items-end justify-between gap-4 border-t border-border pt-5">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted">
                {t.currently.focusLabel}
              </p>

              <p class:list={['mt-2 font-mono text-xs uppercase tracking-wider', accentText]}>
                {item.focus}
              </p>
            </div>

            <span
              aria-hidden="true"
              class:list={[
                'text-2xl transition-transform duration-300 group-hover:translate-x-1',
                accentText,
              ]}
            >
              →
            </span>
          </div>
        </article>
      );
    })}
  </div>

  <footer class="relative mt-6 grid gap-5 rounded-2xl border border-border bg-surface/50 p-5 sm:p-6 lg:grid-cols-[1fr_auto_1fr] lg:items-center">
    <div class="flex flex-wrap items-center gap-4">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-background text-primary-light">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M2 12h4l3-8 4 16 3-8h6" />
        </svg>
      </div>

      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-text-muted">
          {t.currently.footerStatus}
        </p>

        <p class="mt-1 flex items-center gap-2 font-mono text-xs text-success">
          <span class="h-2 w-2 rounded-full bg-success"></span>
          {t.currently.footerHealth}
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2" aria-hidden="true">
      <span class="h-1 w-16 rounded-full bg-primary-light"></span>
      <span class="h-1 w-16 rounded-full bg-success"></span>
      <span class="h-1 w-16 rounded-full bg-border"></span>
    </div>

    <p class="font-mono text-xs leading-6 text-text-muted lg:text-right">
      <span class="mr-2 text-primary-light">//</span>
      {t.currently.footerMessage}
    </p>
  </footer>
</section>