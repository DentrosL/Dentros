---
import { translations } from '../data/translations';

type Lang = keyof typeof translations;

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = translations[lang];
---
<section
  class="mx-auto flex min-h-[calc(100vh-89px)] w-full max-w-6xl items-center px-6"
>
  <div class="max-w-3xl">
    <p class="mb-4 text-sm text-primary-light">
      $ whoami
    </p>

    <h1 class="text-4xl font-bold tracking-tight text-text sm:text-5xl md:text-7xl">
      Laiz Detros
    </h1>

    <p class="mt-4 text-lg text-text-muted sm:text-xl md:text-2xl">
      {t.home.role}
      <span class="text-success">·</span>
      {t.home.focus}
    </p>

    <p class="mt-8 max-w-2xl text-base leading-7 text-text-muted md:text-lg">
      {t.home.description}
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="#work"
        class="rounded-md bg-primary px-5 py-3 text-sm font-bold text-text transition-colors hover:bg-primary-light"
      >
        {t.home.work}
      </a>

      <a
        href="mailto:laizbdetros@gmail.com"
        class="rounded-md border border-surface px-5 py-3 text-sm text-text-muted transition-colors hover:border-primary hover:text-text"
      >
        {t.home.contact}
      </a>
    </div>

    <div class="mt-12 flex items-center gap-3 text-xs text-text-muted">
      <span class="text-success">●</span>
      <span>{t.home.availability}</span>
    </div>
  </div>
</section>