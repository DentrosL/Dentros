---
import { translations } from '../data/translations';

type Lang = keyof typeof translations;

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = translations[lang];

const links = [
  {
    label: t.nav.work,
    href: '#work',
  },
  {
    label: t.nav.about,
    href: '#about',
  },
  {
    label: t.nav.contact,
    href: '#contact',
  },
];

const languages = [
  {
    label: 'EN',
    href: '/',
    active: lang === 'en',
  },
  {
    label: 'PT',
    href: '/pt/',
    active: lang === 'pt',
  },
];
---

<nav class="mx-auto w-full max-w-6xl px-4 py-5 sm:px-6 md:py-6">
  <div class="flex items-center justify-between">
    <a
      href="/"
      class="text-base font-bold text-text transition-colors hover:text-primary-light sm:text-lg"
    >
      &lt;dentros /&gt;
    </a>

    <!-- Desktop -->
    <div class="hidden items-center gap-6 text-sm md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-text-muted transition-colors hover:text-primary-light"
        >
          {link.label}
        </a>
      ))}

      <span class="text-surface">|</span>

      <div
        class="flex rounded-md border border-primary-light/20 bg-primary-light/10 p-1 backdrop-blur-sm"
      >
        {languages.map((language) => (
          <a
            href={language.href}
            class:list={[
              'rounded px-2 py-1 text-xs transition-colors',
              language.active
                ? 'bg-primary text-text'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {language.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile -->
    <details class="relative md:hidden">
      <summary
        class="cursor-pointer list-none rounded-md border border-surface px-3 py-2 text-sm text-text-muted transition-colors hover:border-primary hover:text-text"
      >
        {t.nav.menu}
      </summary>

      <div
        class="absolute right-0 top-12 z-20 w-56 rounded-lg border border-surface bg-surface p-4 shadow-xl"
      >
        <div class="flex flex-col gap-4">
          {links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-text-muted transition-colors hover:text-primary-light"
            >
              {link.label}
            </a>
          ))}
        </div>

        <div class="mt-5 border-t border-surface pt-4">
          <p class="mb-3 text-xs text-text-muted">
            {t.nav.language}
          </p>

          <div
            class="inline-flex rounded-md border border-primary-light/20 bg-primary-light/10 p-1 backdrop-blur-sm"
          >
            {languages.map((language) => (
              <a
                href={language.href}
                class:list={[
                  'rounded px-2 py-1 text-xs transition-colors',
                  language.active
                    ? 'bg-primary text-text'
                    : 'text-text-muted hover:text-text',
                ]}
              >
                {language.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </details>
  </div>
</nav>