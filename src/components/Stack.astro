<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="mb-12">
    <p class="text-sm text-primary-light">
      $ tech_stack --list
    </p>

    <h2 class="mt-3 text-3xl font-bold text-text md:text-4xl">
      Stack
    </h2>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <div class="rounded-lg border border-surface p-6">
      <p class="text-sm text-success">
        strong
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        <span class="text-text">PHP</span>
        <span class="text-text">Laravel</span>
        <span class="text-text">PostgreSQL</span>
      </div>
    </div>

    <div class="rounded-lg border border-surface p-6">
      <p class="text-sm text-primary-light">
        comfortable
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        <span class="text-text">Vue</span>
        <span class="text-text">JavaScript</span>
        <span class="text-text">Git</span>
        <span class="text-text">Docker</span>
      </div>
    </div>

    <div class="rounded-lg border border-surface p-6">
      <p class="text-sm text-text-muted">
        exploring
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        <span class="text-text">Python</span>
        <span class="text-text">TypeScript</span>
        <span class="text-text">Finance</span>
      </div>
    </div>
  </div>
</section>